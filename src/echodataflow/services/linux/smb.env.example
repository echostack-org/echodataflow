# Copy this file to: /etc/echodataflow/smb.env
# Then adjust values as needed; keep owned by root and restrict permissions with chmod 600.
# This file is sourced by the shared auto_mount.sh Bash script on Linux.
# Quote values containing spaces or shell special characters.

# Path to the SMB credentials file; keep owned by root and mode 600
# This file contains username=... and password=... on separate lines
SMB_CREDENTIALS_FILE=/etc/echodataflow/smb.credentials

# Hostname or IP address of the SMB server
SMB_HOST=fileserver.example.org

# Name of the shared folder on the SMB server
SMB_SHARE=data

# Local directory where the SMB share is mounted
SMB_MOUNT_POINT=/mnt/echodataflow

# Numeric user ID of the account that should access the mounted files (id -u)
SMB_UID=1000

# Numeric group ID of the account that should access the mounted files (id -g)
SMB_GID=1000

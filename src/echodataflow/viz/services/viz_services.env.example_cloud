# Copy this file to: ~/.config/echodataflow/viz_services.env
# Then adjust values as needed. The visualization services source this file
# with Bash, so settings below can reference ECHODATAFLOW_HOME.

# Name of conda environment to run services in
ECHODATAFLOW_ENV=echodataflow

# Base home directory for service paths
ECHODATAFLOW_HOME=/home/exouser

# Shared echogram and biological visualization YAML configuration file
ECHODATAFLOW_VIZ_CONFIG=$ECHODATAFLOW_HOME/code_git/echodataflow-recipes/recipes_nrt/edge2cloud_hake/cloud/viz.yaml

# Full path to conda or mamba executable
MAMBA_BIN=$ECHODATAFLOW_HOME/miniforge3/bin/mamba

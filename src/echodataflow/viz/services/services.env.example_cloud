# Copy this file to: ~/.config/echodataflow/services.env
# Then adjust values as needed. Use absolute paths; systemd does not expand
# variables such as $HOME or ~ in this file.

# Name of conda environment to run services in
ECHODATAFLOW_ENV=echodataflow

# Base home directory used by launchd service scripts
ECHODATAFLOW_HOME=/home/exouser

# Absolute working directory for the visualization services
ECHODATAFLOW_WORKDIR=/home/exouser/code_git/echodataflow

# Log directory used by launchd service scripts
ECHODATAFLOW_LOG_DIR=/home/exouser/.local/var/log/echodataflow

# Shared echogram and biological visualization YAML configuration file
ECHODATAFLOW_VIZ_CONFIG=/home/exouser/code_git/echodataflow-recipes/recipes_nrt/edge2cloud_hake/cloud/viz.yaml

# Full path to conda or mamba executable
MAMBA_BIN=/media/volume/shimada_202506_volume/miniforge3/bin/mamba

# Prefect worker pool name
PREFECT_POOL=local

# Prefect API URL override (optional)
# Leave unset to use the active Prefect profile (recommended for Prefect Cloud).
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>

# Optional: Prefect local SQLite DB file path for server preflight checks
PREFECT_DB_PATH=/home/exouser/.prefect/prefect.db

# Optional safety switch for server startup:
# - false: fail fast if DB quick_check is not ok
# - true: archive old DB files and start with a new DB
PREFECT_DB_AUTORESET_ON_FAILURE=true

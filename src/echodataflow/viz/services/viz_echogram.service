[Unit]
Description=Visualization of echogram and ship track
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Source with Bash to expand variable references in services.env.
ExecStart=/bin/bash -c 'set -a; source "%h/.config/echodataflow/services.env" && cd "$${ECHODATAFLOW_WORKDIR:?ECHODATAFLOW_WORKDIR is required}" && exec "$${MAMBA_BIN:?MAMBA_BIN is required}" run -n "$${ECHODATAFLOW_ENV:?ECHODATAFLOW_ENV is required}" python -m echodataflow.viz.viz_echogram --config-file "$${ECHODATAFLOW_VIZ_CONFIG:?ECHODATAFLOW_VIZ_CONFIG is required}"'
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=echodataflow_viz_echogram

[Install]
WantedBy=default.target

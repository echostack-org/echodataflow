[Unit]
Description=Visualization of biological estimates
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/exouser/code_git/echodataflow/src/echodataflow/viz
Environment=PATH=/home/exouser/miniforge3/condabin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/exouser/.config/echodataflow/services.env
ExecStart=/usr/bin/env bash -lc '"${MAMBA_BIN}" run -n "${ECHODATAFLOW_ENV}" python viz_bio.py'
Restart=always
RestartSec=30
StartLimitInterval=300
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shimada_202506_bio

[Install]
WantedBy=multi-user.target

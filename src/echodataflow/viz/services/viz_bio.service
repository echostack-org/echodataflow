[Unit]
Description=Visualization of biological estimates
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/echodataflow/services.env
ExecStart=/bin/bash -c 'cd "$${ECHODATAFLOW_WORKDIR:?ECHODATAFLOW_WORKDIR is required}" && exec "$${MAMBA_BIN:?MAMBA_BIN is required}" run -n "$${ECHODATAFLOW_ENV:?ECHODATAFLOW_ENV is required}" python -m echodataflow.viz.viz_bio --config-file "$${ECHODATAFLOW_VIZ_CONFIG:?ECHODATAFLOW_VIZ_CONFIG is required}"'
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=echodataflow_viz_bio

[Install]
WantedBy=default.target
